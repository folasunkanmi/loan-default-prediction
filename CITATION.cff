cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "Loan Default Prediction & Credit Risk Intelligence"
version: "1.1.3"
date-released: "2026-11-23"
authors:
  - family-names: "Folasunkanmi"
    given-names: ""
    orcid: ""
repository-code: "https://github.com/folasunkanmi/loan-default-prediction"
url: "https://github.com/folasunkanmi/loan-default-prediction"
abstract: >-
  An educational machine learning project for predicting loan default
  probability using a balanced curated Lending Club sample. Implements Logistic
  Regression, Random Forest, XGBoost and LightGBM with preprocessing pipelines,
  validation-only threshold selection, and SHAP explainability. Includes an
  interactive Streamlit demonstration. Metrics are not representative of
  real-world lending performance.
keywords:
  - credit risk
  - loan default
  - probability of default
  - Lending Club
  - machine learning
  - SHAP
  - fintech
  - explainable AI
license: MIT
references:
  - type: dataset
    title: "Lending Club loan data (cleaned sample)"
    authors:
      - family-names: "George"
        given-names: "Nathan"
      - family-names: "Gedeck"
        given-names: "Peter"
    url: "https://github.com/gedeck/practical-statistics-for-data-scientists"
    notes: "Derived from public Lending Club loan data releases."
